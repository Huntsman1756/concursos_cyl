{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "enabled_providers": ["nan", "openai"],
  "default_agent": "orchestrator",
  "subagent_depth": 0,
  "mcp": {
    "esdata": {
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".agent-runs/**",
      ".tmp/**",
      ".worktrees/**",
      "_codex_tmp/**",
      "_codex_worktrees/**"
    ]
  },
  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NAN Builders",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6 (NAN)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "gemma4": {
          "name": "Gemma 4 (NAN)",
          "reasoning": true,
          "tool_call": false,
          "limit": { "context": 262144, "output": 16384 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (NAN)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 65536 }
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5 (NAN)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 65536 }
        }
      }
    }
  }
}
