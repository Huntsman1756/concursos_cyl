AXIS-VERSION="2006";
CREATION-DATE="20260809";
CHARSET="ANSI";
SUBJECT-AREA="FP GRADO MEDIO";
SUBJECT-CODE="BCCFP";
MATRIX="3";
TITLE="2.8. Distrib. bases de cotización afiliados c. ajena con jornada t.  completo (1) por cohorte, periodo de análisis, medida (2) y  ciclo-grupo (3).";
CONTENTS="2.8. Distrib. bases de cotización afiliados c. ajena con jornada t.  completo (1)";
CODEPAGE="iso-8859-15";
DESCRIPTION="";
COPYRIGHT=YES;
NOTE="1) Los resultados corresponden a la base de cotización por  contingencias com"
"unes.    # 2) Los quintiles dividen al colectivo en cinco grupos de igual  ta"
"maño, de acuerdo con su base de cotización, de menor a mayor. Así,  el primer"
" quintil abarca el 20% de los graduados afiliados con menor  base de cotizaci"
"ón, mientras que el quinto quintil abarca al 20% de  los graduados con mayor "
"base de cotización.    # 3) Se muestran únicamente aquellos ciclos o grupos d"
"e ciclos (dentro  de una familia profesional) para los que la información es "
" representativa.    # 4) Se incluyen los ciclos formativos de las familias pr"
"ofesionales:  Edificación y Obra Civil,  Energía y Agua e Industrias Extracti"
"vas.   # (..) Dato no disponible o con falta de representatividad.    # (p) D"
"atos provisionales, ajustados a la inserción en los 3 años  posteriores a la "
"graduación para la cohorte 2021-2022 y en los 2 años  posteriores para la coh"
"orte 2022-2023.";
DECIMALS=2;
SHOWDECIMALS=0;
STUB="Cohorte","Periodo de análisis","Medida (2)";
HEADING="Ciclo-grupo (3)";
VALUES("Cohorte")="2011-2012","2012-2013","2013-2014","2014-2015","2015-2016","2016-2017","2017-2018",
"2018-2019","2019-2020","2020-2021","2021-2022 (p)","2022-2023 (p)";
VALUES("Periodo de análisis")="Primer año","Segundo año","Tercer año","Cuarto año";
VALUES("Medida (2)")="Límite inferior segundo quintil","Límite inferior tercer quintil","Media",
"Límite inferior cuarto quintil","Límite inferior quinto quintil";
VALUES("Ciclo-grupo (3)")="Actividades comerciales","ACTIVIDADES FÍSICAS Y DEPORTIVAS",
"ADMINISTRACIÓN Y GESTIÓN","Aprovechamiento y conservación del medio natural",
"ARTES GRÁFICAS","Atención a personas en situación de dependencia","Carrocería",
"Cocina y gastronomía","Cuidados auxiliares de enfermería (LOGSE)",
"Electromec. de vehículos autom. - Electromec. de maquinaria - Mantenim. material rodante ferrov.",
"Emergencias sanitarias","Emergencias y protección civil",
"Equipos electrónicos de consumo (LOGSE)","Estética y belleza",
"Farmacia y parafarmacia","Gestión administrativa","IMAGEN Y SONIDO",
"INDUSTRIAS ALIMENTARIAS",
"Instalaciones de producción de calor - Instalaciones frigoríficas y de climatización",
"Instalaciones de telecomunicaciones","Instalaciones eléctricas y automáticas",
"Jardinería y floristería","MADERA, MUEBLE Y CORCHO",
"Mantenimiento electromecánico","MARÍTIMO-PESQUERA","Mecanizado",
"Peluquería y cosmética capilar - Caracterización (LOGSE)",
"Producción agroecológica - Producción agropecuaria","QUÍMICA",
"Servicios de restauración","Sistemas microinformáticos y redes",
"Soldadura y calderería - Conformado por moldeo de metales y polímeros",
"Vídeo, disc-jockey y sonido","Ciclos de otras familias profesionales (4)";
