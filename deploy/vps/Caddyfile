salida-cyl.157-90-22-40.sslip.io {
	root * /srv/salida-cyl/current
	encode zstd gzip

	header {
		?Cache-Control "no-cache"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@immutable path /assets/* /data/v1/snapshots/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Data resources must never fall back to the SPA shell: a missing snapshot
	# file served as index.html (HTTP 200, text/html) under a year-long
	# immutable cache policy poisons browsers permanently. Missing data files
	# are plain 404s, stripped of cacheability by handle_errors.
	handle /data/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "Recurso no encontrado" 404
	}

	# Minimal operational metrics without request URLs, addresses or headers.
	log {
		output file /var/log/caddy/salida-cyl-access.json {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
}
